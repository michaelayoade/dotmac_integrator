# Every value is an overridable knob with a documented default (see
# src/dotmac_integrator/settings.py). Nothing here is a business decision:
# retry, backoff and lease durations belong to dotmac_integration.ExecutionPolicy.

DEPLOYMENT_ID=integrator-local
ENVIRONMENT=development

# The ONLINE role. Platform role, never app_user — every table here is
# platform-plane (ADR-0023) and app_user is REVOKEd from all of them.
DATABASE_URL=postgresql+psycopg://platform_api@localhost:5432/integrator

# The OWNER role. Used only by `alembic upgrade`, never at runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://app_admin@localhost:5432/integrator

DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

HOST=127.0.0.1
PORT=8080

WORKER_ENABLED=true
WORKER_POLL_SECONDS=5.0
WORKER_LEASE_SWEEP_SECONDS=60.0
WORKER_BATCH_SIZE=20

# ── Operator authentication ─────────────────────────────────────────────────
# The /operations surface can replay a delivery, reclaim a lease and enable a
# connector against live provider credentials. `platform_admin` is the only
# implemented mechanism and there is deliberately no 'none'.
OPERATOR_AUTH_MECHANISM=platform_admin

# KERNEL knobs, read by dotmac-kernel itself. The operator surface
# authenticates HOST-EXACT: a request whose Host is not this value is refused
# before any lookup. `localhost` is fatal in production.
PLATFORM_ROOT_DOMAIN=localhost
# Signs operator bearer tokens. The value below is the kernel's development
# default and is FATAL in production — anyone who has read the kernel can forge
# a token with it. OpenBao (dotmac-observe): secret/dotmac/integrator/jwt
JWT_SECRET=dev-insecure-change-me

# ── Held secret material (ADR-0009) ─────────────────────────────────────────
# WHICH mechanisms may be dereferenced, and WHERE each is confined. Not what a
# secret is: the set of material this deployment needs is the `secret_refs`
# already stored in the module's configuration revisions.
#
# Only `env` and `file` are implemented — neither reaches a network. The
# network-backed schemes dotmac-integration recognises (bao, aws-sm, gcp-sm)
# need a store client, an address and an auth method, which is a reviewed
# change with a named deployment target rather than a toggle. Enabling one here
# is refused at boot.
SECRET_SCHEMES=env,file
# `env://NAME` is refused unless NAME starts with this. A configuration
# revision is operator-written DATA and must not be able to name DATABASE_URL.
SECRET_ENV_PREFIX=INTEGRATOR_SECRET_
# `file://` references are confined to this directory, resolved before the
# containment check so `..` cannot climb out. A missing directory refuses the
# boot; a missing FILE inside it refuses only that installation's enablement.
SECRET_FILE_ROOT=/run/secrets

# Registry credentials for `poetry install`. NEVER commit real values — this
# names WHERE the secret lives, not what it is. `ci-reader` holds read:package
# and nothing more; the publish token is not used by this repository.
# OpenBao (dotmac-observe): secret/dotmac/forgejo/read-token, field `value`
# POETRY_HTTP_BASIC_FORGEJO_USERNAME=ci-reader
# POETRY_HTTP_BASIC_FORGEJO_PASSWORD=
