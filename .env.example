# Every value is an overridable knob with a documented default (see
# src/dotmac_integrator/settings.py). Nothing here is a business decision:
# retry, backoff and lease durations belong to dotmac_integration.ExecutionPolicy.

DEPLOYMENT_ID=integrator-local
ENVIRONMENT=development

# The ONLINE role. Platform role, never app_user — every table here is
# platform-plane (ADR-0023) and app_user is REVOKEd from all of them.
DATABASE_URL=postgresql+psycopg://platform_api@localhost:5432/integrator

# The OWNER role. Used only by `alembic upgrade`, never at runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://app_admin@localhost:5432/integrator

DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

HOST=127.0.0.1
PORT=8080

WORKER_ENABLED=true
WORKER_POLL_SECONDS=5.0
WORKER_LEASE_SWEEP_SECONDS=60.0
WORKER_BATCH_SIZE=20

# ── Receipt → product delivery ──────────────────────────────────────────────
# WHERE recorded observations land, and with what credential. Everything here
# is transport addressing. There is deliberately no retry count, no wait and no
# attempt limit: `dotmac_integration.ExecutionPolicy` owns those, and a knob
# here would be a second answer to a question that already has one.
#
# OFF by default. A deployment with no destination configured must fail closed
# and say so in a log line — never deliver nowhere and mark receipts done.
PRODUCT_PORT_ENABLED=false

# 'mirror' posts to the destination's SHADOW port, which records NOTHING and
# answers with a parity verdict; 'write' posts to the port that records. The
# default is the safe one: a deployment misconfigured into shadow produces
# evidence, and one misconfigured into write records facts nobody agreed to
# record — there is no un-recording those.
#
# This is the ONLY switch. The worker starts the shadow pass or the delivery
# pump from the installed client's own declared direction, so there is no
# second flag that could disagree with it.
PRODUCT_PORT_MODE=mirror

# The destination application, checked against the application the module
# resolved from the capability's declared owner. A mismatch is refused, never
# delivered.
PRODUCT_PORT_APPLICATION=
PRODUCT_PORT_BASE_URL=
# The path the destination MOUNTS its API under, which is not the same as the
# prefix on its router. Check the mounting, not the router.
PRODUCT_PORT_API_PATH_PREFIX=/api/v1
PRODUCT_PORT_TIMEOUT_SECONDS=15.0

# Required when PRODUCT_PORT_MODE=mirror. Use the immutable image/contract
# revision under comparison (for example the deployment image digest), never a
# mutable environment name. A new value deliberately re-drives the population.
PRODUCT_PORT_SHADOW_REVISION=

# Transient `no_counterpart` and `unreadable` comparisons are sampled again
# only after this interval. This changes no receipt state and is NOT delivery
# retry policy; the reusable module remains the sole owner of delivery retry.
PRODUCT_PORT_SHADOW_RETRY_SECONDS=300.0

# `<local-binding-uuid>=<destination-binding-uuid>` pairs, comma separated.
#
# READ THIS BEFORE SETTING IT. The destination's port is keyed on ITS OWN
# capability-binding UUID, which lives in ITS database. This deployment's
# binding id is a different UUID in a different database and the two are NOT
# interchangeable — posting the wrong one 404s in the best case and writes to
# somebody else's binding in the worst. There is deliberately no derivation.
#
# HOW the destination's id gets here is an OPEN DECISION, recorded as such in
# the destination's own cutover document. Until it is decided, an operator
# reads the id out of the destination and writes it here, and an unmapped
# binding is refused before the network rather than guessed at.
PRODUCT_PORT_BINDINGS=

# `<capability.id.vN> = <application>/<module> : <summary>`, `;` separated.
# The capability vocabulary this deployment routes by.
#
# ALSO A STOPGAP. A capability is declared by its owning business module, and
# how that declaration reaches this assembly — a checked-in manifest, a build
# artefact, or a field on the owner's module manifest — is undecided. What is
# NOT open is that the Integrator may never mint one, so this is transcribed
# rather than defaulted, and an empty value with the port enabled is a refused
# boot rather than an empty registry.
# PRODUCT_PORT_CAPABILITIES=messaging.receive.v1 = sub/communications : Inbound message observations
PRODUCT_PORT_CAPABILITIES=

# The machine credential presented to the destination as `X-Api-Key`. A
# REFERENCE, never a value — it is dereferenced ONCE at startup and held
# (ADR-0009), and this file is committed. `env://` is confined to
# SECRET_ENV_PREFIX and `file://` to SECRET_FILE_ROOT.
#
# The scope on the destination's side must match PRODUCT_PORT_MODE: a shadow
# credential carries only the mirror scope and can record nothing, which is
# what makes "shadow" a property rather than a promise. Re-scoping is issuing a
# new key and revoking the old one, never mutating an existing one in place.
PRODUCT_PORT_API_KEY_REF=

# ── Operator authentication ─────────────────────────────────────────────────
# The /operations surface can replay a delivery, reclaim a lease and enable a
# connector against live provider credentials. `platform_admin` is the only
# implemented mechanism and there is deliberately no 'none'.
OPERATOR_AUTH_MECHANISM=platform_admin

# KERNEL knobs, read by dotmac-kernel itself. The operator surface
# authenticates HOST-EXACT: a request whose Host is not this value is refused
# before any lookup. `localhost` is fatal in production.
PLATFORM_ROOT_DOMAIN=localhost
# Signs operator bearer tokens. The value below is the kernel's development
# default and is FATAL in production — anyone who has read the kernel can forge
# a token with it. OpenBao (dotmac-observe): secret/dotmac/integrator/jwt
JWT_SECRET=dev-insecure-change-me

# ── Held secret material (ADR-0009) ─────────────────────────────────────────
# WHICH mechanisms may be dereferenced, and WHERE each is confined. Not what a
# secret is: the set of material this deployment needs is the `secret_refs`
# already stored in the module's configuration revisions.
#
# Only `env` and `file` are implemented — neither reaches a network. The
# network-backed schemes dotmac-integration recognises (bao, aws-sm, gcp-sm)
# need a store client, an address and an auth method, which is a reviewed
# change with a named deployment target rather than a toggle. Enabling one here
# is refused at boot.
SECRET_SCHEMES=env,file
# `env://NAME` is refused unless NAME starts with this. A configuration
# revision is operator-written DATA and must not be able to name DATABASE_URL.
SECRET_ENV_PREFIX=INTEGRATOR_SECRET_
# `file://` references are confined to this directory, resolved before the
# containment check so `..` cannot climb out. A missing directory refuses the
# boot; a missing FILE inside it refuses only that installation's enablement.
SECRET_FILE_ROOT=/run/secrets

# Which revision supplies each composed effect. `dotmac_integrator.migrate` sets
# this itself (see src/dotmac_integrator/migration_bindings.py); export it only
# to run a DIFFERENT binding set, e.g. while diagnosing an ordering problem.
# DOTMAC_MIGRATION_BINDINGS=dotmac_integrator.migration_bindings:ASSEMBLY_PREREQUISITE_BINDINGS

# ── Public ingress ──────────────────────────────────────────────────────────
# Mount GET/POST /ingress/{endpoint_key}. False for a replica that runs the
# worker and the operator surface but takes no provider traffic.
INGRESS_ENABLED=true
# Largest inbound provider body READ, enforced while streaming and before any
# signature check — not measured afterwards, which would buffer the memory it
# is trying to refuse. Generic on purpose: a per-connector byte limit would be
# connector policy, which neither this assembly nor the module may hold.
INGRESS_MAX_BODY_BYTES=1048576

# Prometheus scrape endpoint. A knob rather than a constant: a deployment that
# exports through a sidecar, or one whose ingress cannot be trusted to keep
# /metrics internal, turns it off without a code change.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# The fleet's observability auth standard: Authorization: Bearer <token>,
# compared in constant time, unauthorized answered 404 rather than 403 so the
# endpoint is indistinguishable from absent. UNSET falls back to loopback only,
# never to open, and is PROD-FATAL — a production replica binds a routable
# interface, so "loopback only" there is an endpoint nobody can scrape on a
# port anybody can reach.
#
# Never a real value in this file. Same value as the scrape credentials_file on
# the observe host; rotate the two together.
# OpenBao (dotmac-observe): secret/dotmac/integrator/metrics-token, field `value`
METRICS_TOKEN=

# ── Payload retention — DELIBERATELY UNSET ──────────────────────────────────
# Two decisions this repository refuses to make for you, and they are not
# oversights. dotmac_integration.retention ships no default retention period
# and no default legal-policy owner: a period baked in anywhere becomes the
# fleet's data-retention posture without anyone deciding it, and it would be
# invisible precisely because it worked.
#
# Both are commented out because `Settings` sets extra="forbid" — an
# uncommented variable with no matching field fails the boot, which is the
# right outcome for a half-configured deployment.
#
# Setting them is a THREE-place change, one decision:
#   1. here, for whatever process runs the purge;
#   2. the same number of seconds in the recording rule in
#      deploy/alerts/ingress.rules.yml;
#   3. nothing else — the module reads them and refuses until both are present.
#
# INTEGRATION_PAYLOAD_RETENTION_DAYS=
# INTEGRATION_RETENTION_LEGAL_POLICY_OWNER=

# Registry credentials for `poetry install`. NEVER commit real values — this
# names WHERE the secret lives, not what it is. `ci-reader` holds read:package
# and nothing more; the publish token is not used by this repository.
# OpenBao (dotmac-observe): secret/dotmac/forgejo/read-token, field `value`
# POETRY_HTTP_BASIC_FORGEJO_USERNAME=ci-reader
# POETRY_HTTP_BASIC_FORGEJO_PASSWORD=
