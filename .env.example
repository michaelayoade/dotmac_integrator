# Every value is an overridable knob with a documented default (see
# src/dotmac_integrator/settings.py). Nothing here is a business decision:
# retry, backoff and lease durations belong to dotmac_integration.ExecutionPolicy.

DEPLOYMENT_ID=integrator-local
ENVIRONMENT=development

# The ONLINE role. Platform role, never app_user — every table here is
# platform-plane (ADR-0023) and app_user is REVOKEd from all of them.
DATABASE_URL=postgresql+psycopg://platform_api@localhost:5432/integrator

# The OWNER role. Used only by `alembic upgrade`, never at runtime.
MIGRATION_DATABASE_URL=postgresql+psycopg://app_admin@localhost:5432/integrator

DB_POOL_SIZE=5
DB_POOL_MAX_OVERFLOW=5

HOST=127.0.0.1
PORT=8080

WORKER_ENABLED=true
WORKER_POLL_SECONDS=5.0
WORKER_LEASE_SWEEP_SECONDS=60.0
WORKER_BATCH_SIZE=20

# Prometheus scrape endpoint. A knob rather than a constant: a deployment that
# exports through a sidecar, or one whose ingress cannot be trusted to keep
# /metrics internal, turns it off without a code change.
METRICS_ENABLED=true
METRICS_PATH=/metrics

# The fleet's observability auth standard: Authorization: Bearer <token>,
# compared in constant time, unauthorized answered 404 rather than 403 so the
# endpoint is indistinguishable from absent. UNSET falls back to loopback only,
# never to open, and is PROD-FATAL — a production replica binds a routable
# interface, so "loopback only" there is an endpoint nobody can scrape on a
# port anybody can reach.
#
# Never a real value in this file. Same value as the scrape credentials_file on
# the observe host; rotate the two together.
# OpenBao (dotmac-observe): secret/dotmac/integrator/metrics-token, field `value`
METRICS_TOKEN=

# ── Payload retention — DELIBERATELY UNSET ──────────────────────────────────
# Two decisions this repository refuses to make for you, and they are not
# oversights. dotmac_integration.retention ships no default retention period
# and no default legal-policy owner: a period baked in anywhere becomes the
# fleet's data-retention posture without anyone deciding it, and it would be
# invisible precisely because it worked.
#
# Both are commented out because `Settings` sets extra="forbid" — an
# uncommented variable with no matching field fails the boot, which is the
# right outcome for a half-configured deployment.
#
# Setting them is a THREE-place change, one decision:
#   1. here, for whatever process runs the purge;
#   2. the same number of seconds in the recording rule in
#      deploy/alerts/ingress.rules.yml;
#   3. nothing else — the module reads them and refuses until both are present.
#
# INTEGRATION_PAYLOAD_RETENTION_DAYS=
# INTEGRATION_RETENTION_LEGAL_POLICY_OWNER=

# Registry credentials for `poetry install`. NEVER commit real values — this
# names WHERE the secret lives, not what it is. `ci-reader` holds read:package
# and nothing more; the publish token is not used by this repository.
# OpenBao (dotmac-observe): secret/dotmac/forgejo/read-token, field `value`
# POETRY_HTTP_BASIC_FORGEJO_USERNAME=ci-reader
# POETRY_HTTP_BASIC_FORGEJO_PASSWORD=
