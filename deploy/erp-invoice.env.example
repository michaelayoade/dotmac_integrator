# ERP invoice-observation topology. This file contains no credentials or hosts.
# Supply DATABASE_URL, MIGRATION_DATABASE_URL, PLATFORM_ROOT_DOMAIN and
# JWT_SECRET from the deployment environment when rendering Compose.
COMPOSE_PROJECT_NAME=integrator-erp-invoice
COMPOSE_NETWORK=integrator-erp-invoice
DEPLOYMENT_ID=erp-invoice-accounting-sync
PUBLISHED_PORT=18081
SECRET_FILE_ROOT_HOST=./secrets/erp-invoice
SECRET_FILE_ROOT=/run/secrets/erp-invoice

DATABASE_URL=
MIGRATION_DATABASE_URL=
PLATFORM_ROOT_DOMAIN=
JWT_SECRET=

PRODUCT_PORT_ENABLED=false
PRODUCT_PORT_MODE=mirror
PRODUCT_PORT_DESCRIPTOR_URL=
PRODUCT_PORT_DESCRIPTOR_EXPECTED_DIGEST=
PRODUCT_PORT_API_KEY_REF=
PRODUCT_PORT_SHADOW_REVISION=
