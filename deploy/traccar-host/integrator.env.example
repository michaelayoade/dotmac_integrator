# Copy to a root-readable host file outside the checkout. Do not commit values.
INTEGRATOR_TRACCAR_IMAGE=registry.dotmac.io/dotmac/integrator@sha256:<released-image-digest>
DEPLOYMENT_ID=integrator-traccar-production
DATABASE_URL=
MIGRATION_DATABASE_URL=
PLATFORM_ROOT_DOMAIN=integrator.dotmac.io
JWT_SECRET=
METRICS_TOKEN=

# Authenticated ERP -> Integrator query callers. The value is JSON and each
# caller is restricted to the exact binding UUIDs ERP is allowed to query.
PRODUCT_QUERY_CALLERS=[]
PRODUCT_CONTRACT_REGISTRY_URL=
PRODUCT_CONTRACT_REGISTRY_EXPECTED_DIGEST=
PRODUCT_CONTRACT_REGISTRY_TIMEOUT_SECONDS=15

# OpenBao material is projected by the host secret agent into three distinct,
# mode-0400 files. The Integrator receives no OpenBao token and ERP receives no
# Traccar file or mount.
TRACCAR_SERVICE_EMAIL_FILE=/etc/dotmac/secrets/integrator-traccar/service-email
TRACCAR_SERVICE_PASSWORD_FILE=/etc/dotmac/secrets/integrator-traccar/service-password
ERP_CONTRACT_REGISTRY_API_KEY_FILE=/etc/dotmac/secrets/integrator-traccar/erp-contract-registry-api-key

INTEGRATOR_TRACCAR_PORT=8083
INTEGRATOR_RUNTIME_NETWORK=dotmac_integrator_traccar_runtime
TRACCAR_API_NETWORK=dotmac_traccar_api
