      "$defs": {
        "InvoiceAccountingSyncIssue": {
          "additionalProperties": false,
          "description": "One piece of blocked-disposition evidence.\n\nOnly ``code`` is guaranteed present. Sub's real\n``InvoiceAccountingSyncIssueRead`` (and the connector's ``map_item``,\nwhich forwards it) declares ``source_line_id``/``expected_amount``/\n``actual_amount`` as genuinely optional \u2014 a header-level issue such as\nan unallocated discount has no specific line and no expected amount,\nonly an actual one. The connector OMITS an absent optional field from\nthe wire payload rather than sending it as explicit ``null``; a present\nfield that fails to parse is still rejected at the connector before it\nis ever sent. These are typed ``| None`` here both because the wire\npayload can genuinely omit them and to match ERP's own\n``InvoiceSyncIssueEvidence`` persistence shape (that dataclass is frozen\nfor this task). Confirmed against the connector's real, shared-fixture\ncontract test (dotmac_connector_sub_accounting,\n``tests/test_shared_fixture_contract.py``) \u2014 a prior version of this\ndocstring incorrectly claimed all four fields are always populated.",
          "properties": {
            "actual_amount": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Actual Amount"
            },
            "code": {
              "$ref": "#/$defs/InvoiceSyncIssueCode"
            },
            "expected_amount": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Expected Amount"
            },
            "source_line_id": {
              "anyOf": [
                {
                  "format": "uuid",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "default": null,
              "title": "Source Line Id"
            }
          },
          "required": [
            "code"
          ],
          "title": "InvoiceAccountingSyncIssue",
          "type": "object"
        },
